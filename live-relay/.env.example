# -----------------------------------------------------------------------------
# live-relay — required env
# -----------------------------------------------------------------------------

# Port the Fastify server binds to (default 8787).
PORT=8787
HOST=0.0.0.0

# Must EXACTLY match the LIVE_RELAY_TOKEN_SECRET configured inside the Lovable
# app (Cloud → Secrets). Used to verify HMAC-SHA256 signatures.
LIVE_RELAY_TOKEN_SECRET=change-me-shared-with-lovable

# Provider allowlist and credentials. Credentials NEVER leave this process:
# not in logs, not in headers, not in the response.
PROVIDER_HOST=suportejetflix.site
PROVIDER_USER=your-xtream-username
PROVIDER_PASS=your-xtream-password

# Comma-separated list of allowed browser Origins (published URL, custom domain).
# Use `*` for open access (development only).
ALLOWED_ORIGINS=https://tv-magica-brasa-soarestv.lovable.app

# Optional tuning.
FIRST_BYTE_TIMEOUT_MS=8000
MAX_CONCURRENT=50
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
UPSTREAM_UA=XCIPTV/7.0 (Linux; Android 13)
LOG_LEVEL=info
