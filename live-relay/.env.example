# -----------------------------------------------------------------------------
# live-relay — required env (spec V-final)
# -----------------------------------------------------------------------------

# HTTP server binding.
PORT=8787
HOST=0.0.0.0

# AES-256-GCM symmetric key. MUST match LIVE_RELAY_ENCRYPTION_KEY in the
# Lovable Cloud secrets (both sides derive an AES key by SHA-256(this value)).
# Generate 64+ random chars. This value is NEVER exposed to the browser.
LIVE_RELAY_ENCRYPTION_KEY=change-me-must-match-lovable-cloud

# Comma-separated allowlist of upstream provider hosts the relay will connect
# to. Only these hosts (and their subdomains) are accepted from the token.
ALLOWED_UPSTREAM_HOSTS=suportejetflix.site

# Comma-separated allowlist of browser Origins that may call the relay.
# Use the published Lovable URL and any custom domain. `*` = open (dev only).
ALLOWED_ORIGINS=https://tv-magica-brasa-soarestv.lovable.app

# Optional tuning.
FIRST_BYTE_TIMEOUT_MS=8000
MAX_CONCURRENT=50
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
UPSTREAM_UA=XCIPTV/7.0 (Linux; Android 13)
MAX_REDIRECTS=3
LOG_LEVEL=info
